{
	chapter.0D8AC2769130CBEF.title: "04 · База, которая работает"
	chapter.139E2745B99F8758.title: "05 · За границами мира"
	chapter.30C7A4DEF1D06B2B.title: "01 · Первый лагерь"
	chapter.531AB1A7DFCCD4A9.title: "06 · Сердце Элдории"
	chapter.5CA96B9FF7C63FB1.title: "02 · Резонансный завод"
	chapter.7F87C3E27974FD24.title: "03 · Магия производства"
	quest.01B6EF4A576627C0.quest_desc: ["Собери Enchanting Apparatus, Arcane Core и пьедесталы. Магические рецепты видны в JEI."]
	quest.01B6EF4A576627C0.title: "Алтарь инженера"
	quest.042A066D39B2E488.quest_desc: ["Исследуй ветку боссов и порталов DivineRPG. Стандартные способы получения портальных материалов сохранены."]
	quest.042A066D39B2E488.title: "Трофеи приключений"
	quest.04E9C0DB87E7EEBB.quest_desc: ["Собери железо для инструментов и первой книги заклинаний. Прежде чем идти к боссам, построй безопасную базу."]
	quest.04E9C0DB87E7EEBB.title: "Сначала инструменты"
	quest.07D715EDB696FB5F.quest_desc: ["Тепловой генератор подходит для старта. Не строй сотни генераторов: позднее переходи на более производительные источники."]
	quest.07D715EDB696FB5F.title: "Энергия без мегабазы"
	quest.0C752426B15EC075.quest_desc: ["Резонансное ядро + два процессора, два арлемита и два самоцвета. Нужны пьедесталы и 2000 Источника."]
	quest.0C752426B15EC075.title: "Настроенное ядро"
	quest.0D45F5FD462B8C70.quest_desc: ["Соедини сплав, редстоун и магический самоцвет. Один крафт даёт два ядра."]
	quest.0D45F5FD462B8C70.title: "Резонанс"
	quest.1A4620B9B4790CD3.quest_desc: ["Найди кварц AE2 и изучи его выращивание. Для старта не нужен контроллер ME-сети."]
	quest.1A4620B9B4790CD3.title: "Первые кристаллы сети"
	quest.1A47A5825B9E7713.quest_desc: ["Книга новичка доступна без дорогих машин. Изучи снаряд и базовые утилитарные глифы."]
	quest.1A47A5825B9E7713.title: "Первое заклинание"
	quest.1E6CD5DCE42FF0B5.quest_desc: ["Продолжай цепочку миров DivineRPG. У каждого следующего этапа есть собственные материалы и угрозы."]
	quest.1E6CD5DCE42FF0B5.title: "Апалачия"
	quest.1EC1F4B1F2A431B1.quest_desc: ["Подготовь безопасный маршрут и подходящее оружие. Чистая мощность завода не заменяет подготовку к бою."]
	quest.1EC1F4B1F2A431B1.title: "Скайтерн"
	quest.1ECF8BD1F3B8B5E9.quest_desc: ["Настрой автокрафт повторяющихся деталей. Цель — меньше ручного гринда, а не больше одинаковых операций."]
	quest.1ECF8BD1F3B8B5E9.title: "Поручи рутину базе"
	quest.202AC2997D6AA990.quest_desc: ["Первый сделай обычным способом. Затем попробуй удвоение через магический аппарат с арлемитом."]
	quest.202AC2997D6AA990.title: "Инженерный процессор"
	quest.242B6F4167503F2C.quest_desc: ["Металлургический наполнитель — вход в технику. Его можно собрать до резонансного ядра. Нужна энергия."]
	quest.242B6F4167503F2C.title: "Первые цепи"
	quest.280D44AB1E9F79B5.quest_desc: ["Техника, магия и экспедиции здесь связаны. Квесты — ориентир, а не запрет на исследование. Предметы не забираются."]
	quest.280D44AB1E9F79B5.title: "Добро пожаловать в Элдорию"
	quest.28B883137CF911F0.quest_desc: ["Доберись до Эдема. Возьми запас еды, света, инструментов и подготовленную экипировку."]
	quest.28B883137CF911F0.title: "Первое дальнее измерение"
	quest.2B583AD91CD8268E.quest_desc: ["Принеси редкий самоцвет для финального синтеза."]
	quest.2B583AD91CD8268E.title: "Мортум"
	quest.2CC6C56E7C7F1D5B.quest_desc: ["Обычная цепочка Mekanism сохранена. Магическая альтернатива использует усиленный сплав, рупию и самоцветы."]
	quest.2CC6C56E7C7F1D5B.title: "Сплав для больших задач"
	quest.35F33346C41BFF88.quest_desc: ["Заверши испытание Wilden в Ars Nouveau. Сохрани трофей для Сердца Элдории."]
	quest.35F33346C41BFF88.title: "Испытание мага"
	quest.3BE865F4E9780ABB.quest_desc: ["Арлемит понадобится для настроенных ядер и экономичного производства процессоров AE2."]
	quest.3BE865F4E9780ABB.title: "Пора глубже"
	quest.3CB968A982080BE1.quest_desc: ["Финальный коллекционный трофей объединяет три поздних самоцвета, звезду Незера, схему Mekanism, сингулярность AE2 и трофей Ars. Не заменяет исследования оставшихся миров DivineRPG."]
	quest.3CB968A982080BE1.title: "Сердце Элдории"
	quest.3FA6495C24497406.quest_desc: ["Пресс и шаблоны позволяют делать процессоры до контроллера. Это важно: в цепочке нет требования сначала построить готовую сеть."]
	quest.3FA6495C24497406.title: "Точная электроника"
	quest.450E1EE832C04E76.quest_desc: ["Поставь банку Источника рядом с производством. Автоматизируй получение магической энергии."]
	quest.450E1EE832C04E76.title: "Сохраняем Источник"
	quest.47A00F7628345321.quest_desc: ["Используй встроенные цепочки переработки Mekanism и DivineRPG. JEI показывает поддерживаемые материалы; не все руды дают одинаковый выход."]
	quest.47A00F7628345321.title: "Больше из одной руды"
	quest.48CB83F5BD131858.quest_desc: ["Цифровой шахтёр открыт после первых дальних экспедиций. Используй небольшой радиус и выключай машину после работы."]
	quest.48CB83F5BD131858.title: "Добыча становится автоматической"
	quest.4A55A34986A529B7.quest_desc: ["Альтернативный рецепт: базовая схема в центре, реалмит и самоцветы на пьедесталах. Получишь две улучшенные схемы."]
	quest.4A55A34986A529B7.title: "Схемы через ритуал"
	quest.4AFC37E5E959372D.quest_desc: ["Настроенное ядро, самоцветы Эдема и Вайлдвуда, атомные сплавы и Источник создают два божественных ядра."]
	quest.4AFC37E5E959372D.title: "Соединение трёх путей"
	quest.55AF050C759283DB.quest_desc: ["В Элдории корпус использует резонансное ядро. Так магия помогает каждому следующему этапу производства."]
	quest.55AF050C759283DB.title: "Корпус нового поколения"
	quest.5982C15B4F0A87E3.quest_desc: ["Получи самоцвет Источника в камере насыщения. Он соединит первую магию с заводом."]
	quest.5982C15B4F0A87E3.title: "Источник магии"
	quest.61933D3774170C68.quest_desc: ["Настрой производство сингулярности. Именно здесь автоматизация должна избавлять от ручной работы."]
	quest.61933D3774170C68.title: "Предел автоматизации"
	quest.650E077F4DC2BF2D.quest_desc: ["Продвигайся по цепочке измерений DivineRPG. Не забывай возвращать редкие материалы в производство."]
	quest.650E077F4DC2BF2D.title: "Следующая экспедиция"
	quest.65605B3435817B5B.quest_desc: ["Найди реалмит в обычном мире. Позже его можно использовать в магическом производстве схем."]
	quest.65605B3435817B5B.title: "Первый редкий металл"
	quest.65D9D6C5C7C2D5C2.quest_desc: ["Наполни металл редстоуном в Metallurgic Infuser. Точный рецепт смотри в JEI."]
	quest.65D9D6C5C7C2D5C2.title: "Металл с памятью"
	quest.6661473579CC99D9.quest_desc: ["Развивай заклинания по стандартному пути Ars. Новые утилитарные возможности полезны в измерениях DivineRPG."]
	quest.6661473579CC99D9.title: "Книга ученика"
	quest.6DD38200AECD1789.quest_desc: ["Рупия даёт альтернативу обычной цепочке атомных сплавов. Экспедиции начинают окупаться в производстве."]
	quest.6DD38200AECD1789.title: "Редкий катализатор"
	quest.6EA83A975657A550.quest_desc: ["Контроллер использует настроенное ядро. Храни вещи централизованно и не нагружай базу сотнями отдельных воронок."]
	quest.6EA83A975657A550.title: "Единая сеть"
	quest.74548FD41212C3FA.quest_desc: ["Буфер энергии помогает переживать перерывы генерации и поддерживать компактную фабрику."]
	quest.74548FD41212C3FA.title: "Запас на ночь"
}
