{
 chapter.0D8AC2769130CBEF.title: "04 · База, яка працює"
 chapter.139E2745B99F8758.title: "05 · За межами світу"
 chapter.30C7A4DEF1D06B2B.title: "01 · Перший табір"
 chapter.531AB1A7DFCCD4A9.title: "06 · Серце Елдорії"
 chapter.5CA96B9FF7C63FB1.title: "02 · Резонансний завод"
 chapter.7F87C3E27974FD24.title: "03 · Магія виробництва"
 quest.01B6EF4A576627C0.quest_desc: ["Збери Enchanting Apparatus, Arcane Core та п’єдестали. Магічні рецепти можна побачити в JEI."]
 quest.01B6EF4A576627C0.title: "Вівтар інженера"
 quest.042A066D39B2E488.quest_desc: ["Досліджуй босів і портали DivineRPG. Стандартні способи отримання матеріалів для порталів збережено."]
 quest.042A066D39B2E488.title: "Трофеї пригод"
 quest.04E9C0DB87E7EEBB.quest_desc: ["Збери залізо для інструментів і першої книги заклинань. Перш ніж іти до босів, побудуй безпечну базу."]
 quest.04E9C0DB87E7EEBB.title: "Спочатку інструменти"
 quest.07D715EDB696FB5F.quest_desc: ["Тепловий генератор підходить для початку. Не будуй сотні генераторів: згодом переходь на продуктивніші джерела."]
 quest.07D715EDB696FB5F.title: "Енергія без мегабази"
 quest.0C752426B15EC075.quest_desc: ["Резонансне ядро + два процесори, два арлеміти й два самоцвіти. Потрібні п’єдестали та 2000 Джерела."]
 quest.0C752426B15EC075.title: "Налаштоване ядро"
 quest.0D45F5FD462B8C70.quest_desc: ["Поєднай сплав, редстоун і магічний самоцвіт. Один крафт дає два ядра."]
 quest.0D45F5FD462B8C70.title: "Резонанс"
 quest.1A4620B9B4790CD3.quest_desc: ["Знайди кварц AE2 та вивчи його вирощування. Для початку контролер ME-мережі не потрібний."]
 quest.1A4620B9B4790CD3.title: "Перші кристали мережі"
 quest.1A47A5825B9E7713.quest_desc: ["Книга новачка доступна без дорогих машин. Вивчи снаряд і базові допоміжні гліфи."]
 quest.1A47A5825B9E7713.title: "Перше заклинання"
 quest.1E6CD5DCE42FF0B5.quest_desc: ["Продовжуй ланцюжок світів DivineRPG. Кожен наступний етап має власні матеріали й загрози."]
 quest.1E6CD5DCE42FF0B5.title: "Апалачія"
 quest.1EC1F4B1F2A431B1.quest_desc: ["Підготуй безпечний маршрут і відповідну зброю. Сама потужність заводу не замінює підготовку до бою."]
 quest.1EC1F4B1F2A431B1.title: "Скайтерн"
 quest.1ECF8BD1F3B8B5E9.quest_desc: ["Налаштуй автокрафт повторюваних деталей. Мета — менше ручного гринду, а не більше однакових операцій."]
 quest.1ECF8BD1F3B8B5E9.title: "Доручи рутину базі"
 quest.202AC2997D6AA990.quest_desc: ["Перший зроби звичайним способом. Потім спробуй подвоєння через магічний апарат з арлемітом."]
 quest.202AC2997D6AA990.title: "Інженерний процесор"
 quest.242B6F4167503F2C.quest_desc: ["Металургійний наповнювач — початок техніки. Його можна зібрати до резонансного ядра. Потрібна енергія."]
 quest.242B6F4167503F2C.title: "Перші схеми"
 quest.280D44AB1E9F79B5.quest_desc: ["Техніка, магія та експедиції тут пов’язані. Квести — орієнтир, а не заборона на дослідження. Предмети не забираються."]
 quest.280D44AB1E9F79B5.title: "Ласкаво просимо до Елдорії"
 quest.28B883137CF911F0.quest_desc: ["Дістанься Едему. Візьми запас їжі, світла, інструментів і підготовлене спорядження."]
 quest.28B883137CF911F0.title: "Перший далекий вимір"
 quest.2B583AD91CD8268E.quest_desc: ["Принеси рідкісний самоцвіт для фінального синтезу."]
 quest.2B583AD91CD8268E.title: "Мортум"
 quest.2CC6C56E7C7F1D5B.quest_desc: ["Звичайний ланцюжок Mekanism збережено. Магічна альтернатива використовує посилений сплав, рупію та самоцвіти."]
 quest.2CC6C56E7C7F1D5B.title: "Сплав для великих завдань"
 quest.35F33346C41BFF88.quest_desc: ["Заверши випробування Wilden в Ars Nouveau. Збережи трофей для Серця Елдорії."]
 quest.35F33346C41BFF88.title: "Випробування мага"
 quest.3BE865F4E9780ABB.quest_desc: ["Арлеміт знадобиться для налаштованих ядер та економного виробництва процесорів AE2."]
 quest.3BE865F4E9780ABB.title: "Час глибше"
 quest.3CB968A982080BE1.quest_desc: ["Фінальний колекційний трофей поєднує три пізні самоцвіти, зірку Незеру, схему Mekanism, сингулярність AE2 і трофей Ars. Не замінює дослідження решти світів DivineRPG."]
 quest.3CB968A982080BE1.title: "Серце Елдорії"
 quest.3FA6495C24497406.quest_desc: ["Прес і шаблони дають змогу робити процесори до контролера. У ланцюжку немає вимоги спочатку побудувати готову мережу."]
 quest.3FA6495C24497406.title: "Точна електроніка"
 quest.450E1EE832C04E76.quest_desc: ["Постав банку Джерела поруч із виробництвом. Автоматизуй отримання магічної енергії."]
 quest.450E1EE832C04E76.title: "Зберігаємо Джерело"
 quest.47A00F7628345321.quest_desc: ["Використовуй вбудовані ланцюжки переробки Mekanism і DivineRPG. JEI показує підтримувані матеріали; не всі руди дають однаковий вихід."]
 quest.47A00F7628345321.title: "Більше з однієї руди"
 quest.48CB83F5BD131858.quest_desc: ["Цифровий шахтар відкривається після перших далеких експедицій. Використовуй невеликий радіус і вимикай машину після роботи."]
 quest.48CB83F5BD131858.title: "Видобуток стає автоматичним"
 quest.4A55A34986A529B7.quest_desc: ["Альтернативний рецепт: базова схема в центрі, реалміт і самоцвіти на п’єдесталах. Отримаєш дві покращені схеми."]
 quest.4A55A34986A529B7.title: "Схеми через ритуал"
 quest.4AFC37E5E959372D.quest_desc: ["Налаштоване ядро, самоцвіти Едему й Вайлдвуду, атомні сплави та Джерело створюють два божественні ядра."]
 quest.4AFC37E5E959372D.title: "Поєднання трьох шляхів"
 quest.55AF050C759283DB.quest_desc: ["В Елдорії корпус використовує резонансне ядро. Так магія допомагає кожному наступному етапу виробництва."]
 quest.55AF050C759283DB.title: "Корпус нового покоління"
 quest.5982C15B4F0A87E3.quest_desc: ["Отримай самоцвіт Джерела в камері насичення. Він поєднає першу магію із заводом."]
 quest.5982C15B4F0A87E3.title: "Джерело магії"
 quest.61933D3774170C68.quest_desc: ["Налаштуй виробництво сингулярності. Саме тут автоматизація має позбавляти ручної роботи."]
 quest.61933D3774170C68.title: "Межа автоматизації"
 quest.650E077F4DC2BF2D.quest_desc: ["Просувайся ланцюжком вимірів DivineRPG. Не забувай повертати рідкісні матеріали у виробництво."]
 quest.650E077F4DC2BF2D.title: "Наступна експедиція"
 quest.65605B3435817B5B.quest_desc: ["Знайди реалміт у звичайному світі. Згодом його можна використати в магічному виробництві схем."]
 quest.65605B3435817B5B.title: "Перший рідкісний метал"
 quest.65D9D6C5C7C2D5C2.quest_desc: ["Насить метал редстоуном у Metallurgic Infuser. Точний рецепт дивись у JEI."]
 quest.65D9D6C5C7C2D5C2.title: "Метал із пам’яттю"
 quest.6661473579CC99D9.quest_desc: ["Розвивай заклинання стандартним шляхом Ars. Нові допоміжні можливості корисні у вимірах DivineRPG."]
 quest.6661473579CC99D9.title: "Книга учня"
 quest.6DD38200AECD1789.quest_desc: ["Рупія дає альтернативу звичайному ланцюжку атомних сплавів. Експедиції починають окупатися у виробництві."]
 quest.6DD38200AECD1789.title: "Рідкісний каталізатор"
 quest.6EA83A975657A550.quest_desc: ["Контролер використовує налаштоване ядро. Зберігай речі централізовано й не навантажуй базу сотнями окремих лійок."]
 quest.6EA83A975657A550.title: "Єдина мережа"
 quest.74548FD41212C3FA.quest_desc: ["Буфер енергії допомагає переживати перерви генерації та підтримувати компактну фабрику."]
 quest.74548FD41212C3FA.title: "Запас на ніч"
}
